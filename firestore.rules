rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Global Safety Net: Default-deny all unspecified document paths
    match /{document=**} {
      allow read, write: if false;
    }

    // Security Helper Functions
    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn() && (
        (request.auth.token.email == 'ajeetsingh89809@gmail.com' && request.auth.token.email_verified == true) ||
        exists(/databases/$(database)/documents/admins/$(request.auth.uid))
      );
    }

    // 1. Menu Products
    match /products/{productId} {
      allow read: if true;
      allow write: if isAdmin() && isValidId(productId);
    }

    // 2. Menu Categories
    match /categories/{categoryId} {
      allow read: if true;
      allow write: if isAdmin() && isValidId(categoryId);
    }

    // 3. Restaurant Settings
    match /settings/{settingId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // 4. Customer Reviews (Public, Tamper-Proof & Permanent)
    match /reviews/{reviewId} {
      allow read: if true;
      allow create: if isValidId(reviewId) &&
        incoming().customerName is string && incoming().customerName.size() <= 100 &&
        incoming().rating is number && incoming().rating >= 1 && incoming().rating <= 5 &&
        incoming().comment is string && incoming().comment.size() > 0 && incoming().comment.size() <= 1000;
      allow update, delete: if false; // Reviews cannot be altered or removed
    }

    // 5. Orders & Live Tracking
    match /orders/{orderId} {
      allow read: if isValidId(orderId);
      allow create: if isValidId(orderId) &&
        incoming().grandTotal is number && incoming().grandTotal >= 0 &&
        incoming().status in ['Pending', 'Confirmed', 'Preparing', 'Out for Delivery', 'Delivered', 'Cancelled'];
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    // 6. Admin Roles
    match /admins/{adminUid} {
      allow read: if isAdmin();
      allow write: if isSignedIn() && request.auth.token.email == 'ajeetsingh89809@gmail.com' && request.auth.token.email_verified == true;
    }
  }
}

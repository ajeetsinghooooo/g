rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Global Safety Net
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions
    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isAdmin() {
      return request.auth != null && (
        request.auth.token.email == 'ajeetsingh89809@gmail.com' ||
        request.auth.token.email == 'admin@kitchencruze.local'
      );
    }

    // Public Menu Products
    match /products/{productId} {
      allow read: if isValidId(productId);
      allow write: if isAdmin();
    }

    // Public Food Categories
    match /categories/{categoryId} {
      allow read: if isValidId(categoryId);
      allow write: if isAdmin();
    }

    // Customer Reviews
    match /reviews/{reviewId} {
      allow read: if isValidId(reviewId);
      allow create: if isValidId(reviewId) &&
        request.resource.data.userName is string &&
        request.resource.data.userName.size() > 0 &&
        request.resource.data.userName.size() <= 128 &&
        request.resource.data.comment is string &&
        request.resource.data.comment.size() > 0 &&
        request.resource.data.comment.size() <= 2000 &&
        request.resource.data.rating is number &&
        request.resource.data.rating >= 1 &&
        request.resource.data.rating <= 5;
      allow update, delete: if isAdmin();
    }

    // Restaurant Settings
    match /settings/{settingId} {
      allow read: if isValidId(settingId);
      allow write: if isAdmin();
    }

    // Test connection doc
    match /test/{testId} {
      allow read, write: if true;
    }
  }
}

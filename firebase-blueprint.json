{
  "entities": {
    "Product": {
      "title": "Product",
      "description": "Menu item offered by Kitchen Cruze",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "name": { "type": "string", "maxLength": 128 },
        "category": { "type": "string", "maxLength": 128 },
        "price": { "type": "number" },
        "description": { "type": "string", "maxLength": 1000 },
        "image": { "type": "string", "maxLength": 2048 },
        "isVeg": { "type": "boolean" },
        "inStock": { "type": "boolean" },
        "isRecommended": { "type": "boolean" },
        "rating": { "type": "number" },
        "reviewCount": { "type": "number" }
      },
      "required": ["id", "name", "category", "price", "isVeg"]
    },
    "Category": {
      "title": "Category",
      "description": "Food menu category",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "name": { "type": "string", "maxLength": 128 },
        "icon": { "type": "string", "maxLength": 128 },
        "displayOrder": { "type": "number" }
      },
      "required": ["id", "name"]
    },
    "Review": {
      "title": "Review",
      "description": "Customer feedback and ratings for Kitchen Cruze dishes",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "userName": { "type": "string", "maxLength": 128 },
        "dishName": { "type": "string", "maxLength": 128 },
        "rating": { "type": "number" },
        "comment": { "type": "string", "maxLength": 2000 },
        "createdAt": { "type": "string", "maxLength": 64 }
      },
      "required": ["id", "userName", "rating", "comment"]
    },
    "RestaurantSettings": {
      "title": "RestaurantSettings",
      "description": "General restaurant operational settings",
      "type": "object",
      "properties": {
        "name": { "type": "string", "maxLength": 128 },
        "tagline": { "type": "string", "maxLength": 256 },
        "isAcceptingOrders": { "type": "boolean" },
        "minOrderAmount": { "type": "number" },
        "deliveryRadiusKm": { "type": "number" }
      },
      "required": ["name", "isAcceptingOrders"]
    }
  },
  "firestore": {
    "/products/{productId}": {
      "schema": { "$ref": "#/entities/Product" },
      "description": "Dishes and beverage catalogue"
    },
    "/categories/{categoryId}": {
      "schema": { "$ref": "#/entities/Category" },
      "description": "Food categories list"
    },
    "/reviews/{reviewId}": {
      "schema": { "$ref": "#/entities/Review" },
      "description": "Public customer reviews"
    },
    "/settings/{settingId}": {
      "schema": { "$ref": "#/entities/RestaurantSettings" },
      "description": "Restaurant operational configurations"
    }
  }
}
